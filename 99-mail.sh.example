#!/bin/bash

sleep 5

#MAILTO="admins@example.com"
MAILTO="admin@example.com   # <-- adjust"
FROM="certdeploy@example.com   # <-- adjust"
HOSTNAME="$(hostname -f)"
SUBJECT="Zertifikats-Deployment am $(date '+%d.%m.%Y') auf $HOSTNAME"

LOGFILE="/path/to/deploy-status.log   # <-- adjust"
CERTFILE="/path/to/acme.sh   # <-- adjust/example.com/fullchain.cer"
CERTCONF="/path/to/acme.sh   # <-- adjust/example.com/example.com.conf"

# Zertifikatsablaufdatum extrahieren
expiry=$(openssl x509 -enddate -noout -in "$CERTFILE" | cut -d= -f2)
expiry_formatted=$(date -d "$expiry" '+%d.%m.%Y %H:%M:%S')

# Geplantes Datum der naechsten Erneuerung aus der acme.sh-Config lesen
next_renew_formatted=""
if [[ -f "$CERTCONF" ]]; then
  next_renew_str=$(grep -oP "Le_NextRenewTimeStr='\K[^']+" "$CERTCONF")
  if [[ -n "$next_renew_str" ]]; then
    next_renew_formatted=$(date -d "$next_renew_str" '+%d.%m.%Y %H:%M:%S' 2>/dev/null)
  fi
fi

# HTML-Mailaufbau
# Hinweis: Nach jedem Element wird bewusst ein echter Zeilenumbruch eingefuegt.
# HTML ignoriert das beim Rendern, aber es verhindert, dass die MTA/mail-Pipeline
# bei einer einzigen sehr langen Zeile am RFC-5322-Limit (998 Zeichen) hart faltet
# und dabei mitten in einem Tag umbricht.
body="<html><body>
"
body+="<h2>Zertifikats-Deploymentbericht – $HOSTNAME</h2>
"
body+="<p><strong>Datum letzter Lauf:</strong> $(date '+%d.%m.%Y %H:%M:%S')</p>
"
if [[ -n "$next_renew_formatted" ]]; then
  body+="<p><strong>Geplantes Datum nächster Lauf:</strong> ab $next_renew_formatted</p>
"
fi
body+="<p><strong>Zertifikat gültig bis:</strong> $expiry_formatted</p>
"

# Tabellenkopf
body+="<table border='1' cellpadding='6' cellspacing='0' style='border-collapse: collapse;'>
"
body+="<tr style='background-color:#f2f2f2;'><th>Komponente</th><th>Host</th><th>Status</th></tr>
"

total=0
ok=0
fail=0
skip=0

if [[ -f "$LOGFILE" ]]; then
  while read -r line; do
    [[ -z "$line" ]] && continue

    total=$((total + 1))
    status="❓ Unbekannt"
    bgcolor="#fff3cd"

    if [[ "$line" == *"✅ Erfolgreich"* ]]; then
      status="✅ Erfolgreich"
      bgcolor="#d4edda"
      ok=$((ok + 1))
    elif [[ "$line" == *"❌ Fehler"* ]]; then
      status="❌ Fehler"
      bgcolor="#f8d7da"
      fail=$((fail + 1))
    elif [[ "$line" == *"⏭ Übersprungen"* ]]; then
      status="⏭ Übersprungen"
      bgcolor="#e2e3e5"
      skip=$((skip + 1))
    fi

    component=$(echo "$line" | awk '{print $1}')
    host=$(echo "$line" | awk '{print $2}')

    body+="<tr style='background-color:$bgcolor;'><td>$component</td><td style='white-space:nowrap;'>$host</td><td>$status</td></tr>
"
  done < "$LOGFILE"
else
  body+="<tr><td colspan='3'><em>Keine Logdatei gefunden</em></td></tr>
"
fi

# Statistikzeile anhängen
body+="</table>
"
if (( total > 0 )); then
  body+="<p style='margin-top:10px;'><strong>Gesamt:</strong> $total &nbsp;&nbsp;✅ <strong>Erfolgreich:</strong> $ok &nbsp;&nbsp;❌ <strong>Fehlgeschlagen:</strong> $fail"
  if (( skip > 0 )); then
    body+=" &nbsp;&nbsp;⏭ <strong>Übersprungen:</strong> $skip"
  fi
  body+="</p>
"
fi

body+="</body></html>
"

# Mail versenden
echo "$body" | mail -a "Content-Type: text/html" -s "$SUBJECT" -r "$FROM" "$MAILTO"

echo -e "Status-Mail erfolgreich an $MAILTO versendet."

# Logdatei optional löschen
# rm -f "$LOGFILE"
